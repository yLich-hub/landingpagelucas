---
import { perfil } from "../data/perfil";
---

<section id="topo" class="flex min-h-svh flex-col justify-center px-4 pt-20 md:px-6">
  <div class="mx-auto w-full max-w-6xl">
    <p class="mb-4 font-medium" style="font-family: var(--font-mono); font-size: var(--step--1); color: var(--accent);">
      {perfil.cargo} · {perfil.cidade}
    </p>

    <h1 class="font-black uppercase leading-[0.95] tracking-tight" style="font-family: var(--font-display); font-size: var(--step-3);">
      {perfil.nome}
    </h1>

    <p class="mt-6 max-w-2xl" style="font-size: var(--step-1); color: var(--fg-muted);">
      {perfil.posicionamento}
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a
        href="#projetos"
        class="rounded-(--radius) px-6 py-3 font-medium transition-opacity hover:opacity-85"
        style="background: var(--accent); color: var(--bg);"
      >
        Ver projetos
      </a>
      <a
        href={perfil.curriculoPdf}
        download
        class="rounded-(--radius) border px-6 py-3 font-medium transition-colors hover:border-(--fg-muted)"
        style="border-color: var(--border); color: var(--fg);"
      >
        Baixar currículo (PDF)
      </a>
    </div>

    {perfil.numeros.length > 0 && (
      <dl class="mt-16 grid grid-cols-3 gap-4 border-t pt-8" style="border-color: var(--border);">
        {perfil.numeros.map((n) => (
          <div>
            <dd class="font-black" style="font-family: var(--font-display); font-size: var(--step-2);">{n.valor}</dd>
            <dt style="font-size: var(--step--1); color: var(--fg-muted);">{n.label}</dt>
          </div>
        ))}
      </dl>
    )}
  </div>
</section>
