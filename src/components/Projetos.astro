---
import { projetos } from "../data/projetos";
import ProjetoCard from "./ProjetoCard.astro";
import { textos } from "../data/textos";
---

{projetos.length > 0 && (
  <section id="projetos" class="px-4 md:px-6" style="padding-block: var(--space-section);">
    <div class="mx-auto max-w-6xl">
      <h2 class="mb-10 font-black uppercase tracking-tight" style="font-family: var(--font-display); font-size: var(--step-2);">
        {textos.secoes.projetos}
      </h2>
      <div class="flex flex-col gap-8">
        {projetos.map((projeto) => (
          <ProjetoCard projeto={projeto} />
        ))}
      </div>
    </div>
  </section>
)}
