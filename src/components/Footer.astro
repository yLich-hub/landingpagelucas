---
import { perfil } from "../data/perfil";
import { textos } from "../data/textos";

const ano = new Date().getFullYear();
---

<footer class="border-t px-4 py-8 md:px-6" style="border-color: var(--border);">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 sm:flex-row" style="font-size: var(--step--1); color: var(--fg-muted);">
    <p>© {ano} {perfil.nome}</p>
    <ul class="flex flex-wrap items-center justify-center gap-x-5">
      <li><a href={perfil.github} target="_blank" rel="noopener noreferrer" class="inline-block whitespace-nowrap py-2 transition-colors hover:text-(--fg) active:text-(--fg)">{textos.redes.github}</a></li>
      <li><a href={perfil.linkedin} target="_blank" rel="noopener noreferrer" class="inline-block whitespace-nowrap py-2 transition-colors hover:text-(--fg) active:text-(--fg)">{textos.redes.linkedin}</a></li>
      <li><a href={`mailto:${perfil.email}`} class="inline-block whitespace-nowrap py-2 transition-colors hover:text-(--fg) active:text-(--fg)">{textos.redes.email}</a></li>
      <li><a href={perfil.repositorioSite} target="_blank" rel="noopener noreferrer" class="inline-block whitespace-nowrap py-2 transition-colors hover:text-(--fg) active:text-(--fg)">{textos.footer.codigoDoSite}</a></li>
    </ul>
  </div>
</footer>
