---
import { perfil } from "../data/perfil";
import { textos } from "../data/textos";

// quebra de linha preferencial antes do "@" em telas estreitas
const [usuario, dominio] = perfil.email.split("@");
---

<section id="contato" class="px-4 text-center md:px-6" style="padding-block: var(--space-section);">
  <div class="mx-auto max-w-4xl">
    <h2 class="font-black uppercase tracking-tight" style="font-family: var(--font-display); font-size: var(--step-2);">
      {textos.contato.titulo}<span style="color: var(--accent);">?</span>
    </h2>
    <p class="mt-4" style="font-size: var(--step-0); color: var(--fg-muted);">
      {textos.contato.chamada}
    </p>
    <a
      href={`mailto:${perfil.email}`}
      class="texto-leitura mt-6 inline-block wrap-anywhere font-bold underline decoration-2 underline-offset-8 transition-colors hover:text-(--accent) active:text-(--accent)"
      style="font-family: var(--font-mono); font-size: var(--step-1); text-decoration-color: var(--accent);"
    >
      {usuario}<wbr />@{dominio}
    </a>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a href={perfil.curriculoPdf} download class="rounded-(--radius) px-6 py-3 font-medium pressable hover:opacity-85" style="background: var(--accent); color: var(--bg);">
        {textos.botoes.baixarCurriculo}
      </a>
      <a href={perfil.github} target="_blank" rel="noopener noreferrer" class="rounded-(--radius) border px-6 py-3 font-medium pressable hover:border-(--fg-muted)" style="border-color: var(--border);">
        {textos.redes.github}
      </a>
      <a href={perfil.linkedin} target="_blank" rel="noopener noreferrer" class="rounded-(--radius) border px-6 py-3 font-medium pressable hover:border-(--fg-muted)" style="border-color: var(--border);">
        {textos.redes.linkedin}
      </a>
    </div>
  </div>
</section>
