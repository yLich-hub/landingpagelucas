---
import { Image } from "astro:assets";
import type { Projeto } from "../data/projetos";

interface Props {
  projeto: Projeto;
}

const { projeto } = Astro.props;
---

<article class="grid grid-cols-1 overflow-hidden rounded-(--radius) border md:grid-cols-2" style="border-color: var(--border); background: var(--bg-elevated);">
  <Image
    src={projeto.imagem}
    alt={`Captura de tela do projeto ${projeto.nome}`}
    widths={[600, 1200]}
    sizes="(min-width: 768px) 50vw, 100vw"
    loading="lazy"
    class="h-full w-full object-cover"
    style="background: var(--bg);"
  />
  <div class="flex flex-col gap-4 p-6 md:p-8">
    <h3 class="font-black uppercase tracking-tight wrap-break-word" style="font-family: var(--font-display); font-size: var(--step-1);">
      {projeto.nome}
    </h3>
    <p style="color: var(--fg-muted); font-size: var(--step-0); line-height: 1.6;">
      {projeto.problema}
    </p>
    <p style="font-size: var(--step-0); line-height: 1.6;">
      {projeto.descricao}
    </p>
    {projeto.destaque && (
      <p class="border-l-2 pl-3" style="border-color: var(--accent); font-family: var(--font-mono); font-size: var(--step--1); color: var(--accent);">
        {projeto.destaque}
      </p>
    )}
    <ul class="flex flex-wrap gap-2">
      {projeto.stack.map((tech) => (
        <li class="rounded-(--radius) border px-2.5 py-1" style="border-color: var(--border); font-size: var(--step--1); color: var(--fg-muted);">
          {tech}
        </li>
      ))}
    </ul>
    <div class="mt-auto flex flex-wrap gap-3 pt-2">
      <a
        href={projeto.repo}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-(--radius) border px-4 py-2 font-medium pressable hover:border-(--fg-muted)"
        style="border-color: var(--border); font-size: var(--step--1);"
      >
        Ver código
      </a>
      {projeto.demo && (
        <a
          href={projeto.demo}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-(--radius) px-4 py-2 font-medium pressable hover:opacity-85"
          style="background: var(--accent); color: var(--bg); font-size: var(--step--1);"
        >
          Ver ao vivo
        </a>
      )}
    </div>
  </div>
</article>
