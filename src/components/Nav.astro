---
import { perfil } from "../data/perfil";
import { stack } from "../data/stack";
import { projetos } from "../data/projetos";
import { textos } from "../data/textos";

// "lucas.vieira" → "lucas" + "." em destaque + "vieira"
const ponto = perfil.marca.indexOf(".");
const marcaAntes = ponto >= 0 ? perfil.marca.slice(0, ponto) : perfil.marca;
const marcaDepois = ponto >= 0 ? perfil.marca.slice(ponto + 1) : "";

// links somem junto com a seção quando a lista dela está vazia
const links = [
  { href: "#sobre", label: textos.secoes.sobre, visivel: true },
  { href: "#stack", label: textos.secoes.stack, visivel: stack.length > 0 },
  { href: "#projetos", label: textos.secoes.projetos, visivel: projetos.length > 0 },
  { href: "#contato", label: textos.secoes.contato, visivel: true },
].filter((l) => l.visivel);
---

<header class="fixed inset-x-0 top-0 z-50 border-b" style="border-color: var(--border); background: color-mix(in srgb, var(--bg) 85%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);">
  <nav aria-label={textos.nav.ariaLabel} class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 md:px-6">
    <a href="#topo" class="shrink-0 font-bold tracking-tight" style="font-family: var(--font-display); font-size: var(--step-0);">
      {marcaAntes}{ponto >= 0 && <span style="color: var(--accent);">.</span>}{marcaDepois}
    </a>

    <!-- âncoras: escondidas no mobile (página única, rolagem curta); sem JS de menu -->
    <ul class="hidden items-center gap-6 md:flex" style="color: var(--fg-muted); font-size: var(--step--1);">
      {links.map((l) => (
        <li><a href={l.href} class="transition-colors hover:text-(--fg) active:text-(--fg)">{l.label}</a></li>
      ))}
    </ul>

    <div class="flex items-center gap-4">
      <a href={perfil.github} target="_blank" rel="noopener noreferrer" aria-label={textos.redes.github} class="-m-2 p-2 transition-colors text-(--fg-muted) hover:text-(--accent) active:text-(--accent)">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.26 5.66.41.36.78 1.06.78 2.14 0 1.54-.01 2.79-.01 3.17 0 .31.21.68.8.56A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
      </a>
      <a href={perfil.linkedin} target="_blank" rel="noopener noreferrer" aria-label={textos.redes.linkedin} class="-m-2 p-2 transition-colors text-(--fg-muted) hover:text-(--accent) active:text-(--accent)">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.55V9h3.57v11.45Z"/></svg>
      </a>
      <a
        href={perfil.curriculoPdf}
        download
        class="rounded-(--radius) px-3 py-1.5 font-medium pressable hover:opacity-85"
        style="background: var(--accent); color: var(--bg); font-size: var(--step--1);"
      >
        {textos.nav.baixarCv}
      </a>
    </div>
  </nav>
</header>
